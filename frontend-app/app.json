{
  "expo": {
    "name": "Debi-Dorshon",
    "slug": "debi-dorshon",
    "scheme": "debidorshon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Debi-Dorshon uses your location to discover Durga Puja pandals, Metro stations, and nearby transit routes."
      }
    },
    "android": {
      "package": "com.debidorshon.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Debi-Dorshon uses your location to discover Durga Puja pandals, Metro stations, and nearby transit routes."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "814fbb2f-90c3-4893-b382-8e75ddae5ac4"
      }
    }
  }
}
