# Project Settings
PROJECT_NAME="Debi-Dorshon API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# MongoDB Credentials & Connection
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="debi_dorshon_db"
PANDAL_COLLECTION_NAME="pandals"

# OSRM Routing Engine Service Base URL
OSRM_BASE_URL="http://router.project-osrm.org"
OSRM_TIMEOUT_SECONDS=10.0

# Redis Cache Connection URL (Render / Local Docker)
REDIS_URL="redis://localhost:6379/0"

# Concurrency & Rate Limiting
WEB_CONCURRENCY=2
RATE_LIMIT_ROUTE_PLAN="7/minute"
RATE_LIMIT_AUTOCOMPLETE="60/minute"

