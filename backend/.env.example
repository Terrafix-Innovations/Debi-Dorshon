# Project Settings
PROJECT_NAME="Debi-Dorshon API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# MongoDB Credentials & Connection
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="debi_dorshon_db"
PANDAL_COLLECTION_NAME="pandals"

# OSRM Routing Engine Service Base URL
OSRM_BASE_URL="http://router.project-osrm.org"
OSRM_TIMEOUT_SECONDS=10.0

# Map Provider (defaults to OpenStreetMap / CartoDB Voyager; 100% free with no token limits)
MAP_PROVIDER="openstreetmap"

# Optional Legacy Mapbox Access Token (deprecated; leave blank for OpenStreetMap)
# MAPBOX_ACCESS_TOKEN="pk.your_mapbox_public_token_here"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret_here"
GOOGLE_ANDROID_CLIENT_ID="your_android_client_id_here.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your_ios_client_id_here.apps.googleusercontent.com"

# JWT Authentication & User Sandboxing (Permanent non-expiring sessions)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="generate_a_secure_random_hex_key"
JWT_ALGORITHM="HS256"

# Collection names for user data
USER_COLLECTION_NAME="users"
TRIP_COLLECTION_NAME="user_trips"
FAVORITE_COLLECTION_NAME="user_favorites"

# Redis & Caching Settings (optional — falls back to in-memory cache if unavailable)
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_TRANSIT=3600
CACHE_TTL_STATION_PANDALS=1800
CACHE_TTL_AUTOCOMPLETE=900
CACHE_TTL_ROUTE_PLAN=1800

# Rate Limiting Settings
RATE_LIMIT_ROUTE_PLAN="7/minute"
RATE_LIMIT_AUTOCOMPLETE="60/minute"
RATE_LIMIT_DEFAULT="120/minute"

# Concurrency & Multi-worker Setting (Render / Docker)
WEB_CONCURRENCY=2
